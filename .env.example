# Nexus AI Research Hub — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control.

# ── Required ──────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key_here

# ── LLM Model ─────────────────────────────────────────────────
# Available models on Groq (as of Sep 2026):
#   openai/gpt-oss-120b       ← default, most capable
#   openai/gpt-oss-20b        ← faster, lighter
#   qwen/qwen3.8-27b          ← alternative
#   allam-2-7b                ← smallest/fastest
#
# LLM_MODEL=openai/gpt-oss-120b

# ── Embedding Model ───────────────────────────────────────────
# Performance tiers (CPU):
#   all-MiniLM-L6-v2         ← default: 80MB, <1s load, fast ⚡
#   all-mpnet-base-v2         ← 420MB, ~10s load, better quality
#   BAAI/bge-base-en-v1.5    ← 438MB, ~10s load, best quality (needs GPU ideally)
#
# EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Reranker Model ────────────────────────────────────────────
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ── Chunking ──────────────────────────────────────────────────
# CHUNK_SIZE=1500
# CHUNK_OVERLAP=200

# ── Retrieval ─────────────────────────────────────────────────
# RETRIEVER_K=4              # Initial candidates from hybrid search
# RERANKER_TOP_N=3           # Chunks kept after cross-encoder reranking
# BM25_WEIGHT=0.3            # BM25 weight in ensemble (0 = disabled)
# VECTOR_WEIGHT=0.7          # Vector search weight in ensemble
# RERANKER_ENABLED=false     # Cross-encoder off by default (adds ~1-2s/query on CPU)

# ── Storage ───────────────────────────────────────────────────
# CHROMA_PERSIST_DIR=./nexus_db

# ── Chat ──────────────────────────────────────────────────────
# MAX_CHAT_HISTORY=10
